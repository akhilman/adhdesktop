[Unit]
Description=Toggle ironbar on Niri overview enter and exit
PartOf=graphical-session.target
Requires=graphical-session.target
After=graphical-session.target
PartOf=niri.service
After=niri.service
PartOf=ironbar.service
After=ironbar.service

[Service]
Type=simple
# Adjust the command line as you like (e.g., set your own sunrise/sunset times)
ExecStart=python3 ${HOME}/.config/adhdesktop/scripts/ironbar-overview-toggle.py
Restart=on-failure
RestartSec=5
