<labwc_config>
  <theme>
    <default />
    <name>Onyx</name>
  </theme>
  <mouse>
    <default />
    <context name="TitleBar">
      <mousebind button="Middle" action="Click">
        <action name="Lower" />
      </mousebind>
    </context>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="client-list-combined-menu" />
      </mousebind>
    </context>
  </mouse>
  <keyboard>
    <default />
    <keybind key="C-A-a">
      <action name="Execute" command="fuzzel --border-color 666666ff" />
    </keybind>
    <keybind key="C-A-t">
      <action name="Execute" command="xdg-terminal-exec" />
    </keybind>
    <keybind key="C-A-f">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="C-A-h">
      <action name="Execute" command="sh -c 'cliphist list | fuzzel --border-color 666666ff --dmenu | cliphist decode | wl-copy'" />
    </keybind>
    <keybind key="C-A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="C-A-S-Tab">
      <action name="PreviousWindow" />
    </keybind>
  </keyboard>
</labwc_config>
